# Copy to `.env` and adjust the paths if you move this folder.
# The server must be started with these values set (scripts/run_langflow.ps1
# derives them from its own location, so copying the folder just works).

# Where Langflow keeps its config/cache and the secret_key that encrypts
# credential variables.
LANGFLOW_CONFIG_DIR=<project-root>\langflow_data

# The SQLite database that holds the saved flows, global variables,
# credentials and chat history for this project.
LANGFLOW_DATABASE_URL=sqlite:///<project-root-with-forward-slashes>/langflow_data/langflow.db

# Extra folder scanned for custom components (Groq, Jira).
LANGFLOW_COMPONENTS_PATH=<project-root>\Components
